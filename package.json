{
  "name": "sucesso-skinclinic",
  "version": "1.0.0",
  "description": "SkinClinic - gestão para clínicas",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test scripts/test-p0-01-auth.js scripts/test-p0-02-analise-pele.js scripts/test-p0-03-fase0.js scripts/test-named-imports.js scripts/test-qa-catalog.js",
